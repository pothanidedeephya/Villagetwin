# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Optional. For Google Maps satellite and vector basemaps.
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# WEATHER PROVIDER INTEGRATION (OpenWeatherMap / WeatherAPI)
# 1. OPENWEATHER_API_KEY: Recommended. OpenWeatherMap API Key (Get free key at home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# 2. WEATHER_API_KEY: Universal key. If OPENWEATHER_API_KEY is not defined, this key routes to OpenWeatherMap.
WEATHER_API_KEY="your_weather_api_key_here"

# 3. WEATHERAPI_KEY: Optional. WeatherAPI.com forecast key (https://www.weatherapi.com)
WEATHERAPI_KEY="your_weatherapi_key_here"

# Environment Precedence & Server Restart Note:
# - Keys are loaded securely by the backend Express server in order: .env.local > .env.development.local > .env
# - When running in cloud hosting (Render, Railway, Fly.io, etc.), define OPENWEATHER_API_KEY in your hosting dashboard.
# - Restart the backend server (`npm run dev` or `npm start`) whenever environment variables are added or modified.

# SUPABASE POSTGRESQL & POSTGIS CONFIGURATION (Optional for persistent spatial caching)
# 1. Supabase Project REST / PostgREST Access (Client API)
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_ANON_KEY="your_anon_key_here"

# 2. Direct PostgreSQL Connection String (Pooler or Direct PostGIS connection)
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# Discrete Postgres connection variables (alternative to DATABASE_URL)
PGHOST="db.your_project.supabase.co"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="your_database_password_here"

# Optional: Commercial Traffic API (TomTom / HERE / Mapbox) for live vehicle congestion telemetry
TOMTOM_API_KEY="your_tomtom_api_key_here"

# INDIA METEOROLOGICAL DEPARTMENT (IMD) INSTITUTIONAL API CREDENTIALS
# Required for live authenticated polling of https://api.imd.gov.in/api/v1/cyclone_wind
# Request registered API keys from: https://api.imd.gov.in/public/index.php
IMD_API_KEY="your_registered_imd_api_key_here"
IMD_BEARER_TOKEN="your_imd_jwt_bearer_token_here"
